# ==========================================================
# 复制这个文件为 .env，然后把值填进去
#   cp .env.example .env
#   nano .env
# .env 已经被 .gitignore 挡住，不会被提交到 GitHub
# ==========================================================

# ---------- Discord（必填） ----------
# Discord 开发者后台 → 你的 App → Bot → Reset Token
DISCORD_TOKEN=

# 同一页面 → General Information → Application ID
DISCORD_CLIENT_ID=

# 管理员的 Discord 用户 ID，多个用英文逗号分隔
# 获取方法：Discord 设置 → 高级设置 → 打开「开发者模式」
#           然后长按/右键你的头像 → 复制用户 ID
ADMIN_USER_IDS=

# 只在这一个服务器注册斜杠命令（私人服务器填这个，命令会秒生效）
# 留空则注册为全局命令，但 Discord 要最多 1 小时才会推送到客户端
DISCORD_GUILD_ID=


# ---------- AI 供应商（至少填一个） ----------

# Google Gemini —— 免费额度在这里拿，不用绑卡：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI —— 需要预充值：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude —— 需要预充值：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ---------- 可选 ----------
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
